"""
ring_classifier.py — Ring Self-Intersection Type Classifier

Classifies GEOS "Ring Self-intersection" errors into semantic subtypes,
distinguishing genuine topological errors (ambiguous interior) from
tolerance artefacts that are acceptable under less strict validation rules.

Classification taxonomy (based on OGC/ISO 19107 geometry model):

  ┌──────────────────────┬──────────────────┬─────────────────────────┐
  │ Type                 │ Ambiguous int.?  │ Should be an error?     │
  ├──────────────────────┼──────────────────┼─────────────────────────┤
  │ Bow-tie              │ Yes              │ Yes                     │
  │ Figure Eight         │ Yes              │ Yes                     │
  │ Crossing             │ Yes              │ Yes                     │
  │ Pinch                │ No               │ Not necessarily         │
  │ Kiss                 │ No               │ Not necessarily         │
  │ Tangential touch     │ No               │ Not necessarily         │
  │ Spike                │ No               │ Generally no            │
  │ Zero-area loop       │ No               │ Depends                 │
  │ Duplicate edge       │ Depends          │ Depends                 │
  └──────────────────────┴──────────────────┴─────────────────────────┘

Design decisions:
  - All classification logic uses Shapely 2.x vectorised/functional API.
  - Geometries are classified individually (called per-suspect from a batch).
  - The public entry point is RingSelfIntersectionClassifier.classify_batch()
    which accepts a list of Shapely geometries and returns a list of
    RingSIResult dataclass instances — one per input geometry.
  - "Ambiguous interior" types are flagged as conformance errors; the rest
    produce a WARNING so operators can make an informed decision.
  - All Shapely imports are lazy (inside methods) so the module can be
    imported without Shapely installed (QGIS 3.x fallback).
"""

from __future__ import annotations

from dataclasses import dataclass, field
from enum import Enum
from typing import Optional


# ---------------------------------------------------------------------------
# Public types
# ---------------------------------------------------------------------------

class RingSIType(Enum):
    """Semantic subtype of a Ring Self-Intersection error."""

    # ── Genuine errors (ambiguous interior) ──────────────────────────────
    BOW_TIE           = "Bow-tie"
    FIGURE_EIGHT      = "Figure Eight"
    CROSSING          = "Crossing"

    # ── Tolerance / precision artefacts (no ambiguous interior) ──────────
    PINCH             = "Pinch"
    KISS              = "Kiss"
    TANGENTIAL_TOUCH  = "Tangential Touch"
    SPIKE             = "Spike"
    ZERO_AREA_LOOP    = "Zero-area Loop"
    DUPLICATE_EDGE    = "Duplicate Edge"

    # ── Fallback ──────────────────────────────────────────────────────────
    UNKNOWN           = "Unknown"


# Types that produce a conformance ERROR (ambiguous interior).
ERROR_TYPES: frozenset[RingSIType] = frozenset({
    RingSIType.BOW_TIE,
    RingSIType.FIGURE_EIGHT,
    RingSIType.CROSSING,
})

# Types that produce a WARNING (no ambiguous interior, or context-dependent).
WARNING_TYPES: frozenset[RingSIType] = frozenset({
    RingSIType.PINCH,
    RingSIType.KISS,
    RingSIType.TANGENTIAL_TOUCH,
    RingSIType.SPIKE,
    RingSIType.ZERO_AREA_LOOP,
    RingSIType.DUPLICATE_EDGE,
    RingSIType.UNKNOWN,
})


@dataclass
class RingSIResult:
    """Classification result for a single geometry."""

    si_type: RingSIType
    """Semantic subtype of the ring self-intersection."""

    is_error: bool
    """True if the type implies an ambiguous interior (OGC/ISO 19157 error)."""

    description: str
    """Human-readable explanation."""

    touch_point: Optional[tuple[float, float]] = field(default=None)
    """Approximate coordinates of the self-intersection (from is_valid_reason)."""

    area_ratio: Optional[float] = field(default=None)
    """Ratio of fixed_area / original_area (used in bow-tie / crossing detection)."""

    @property
    def severity(self) -> str:
        return "ERROR" if self.is_error else "WARNING"


# ---------------------------------------------------------------------------
# Internal helpers
# ---------------------------------------------------------------------------

def _extract_touch_point(reason: str) -> Optional[tuple[float, float]]:
    """
    Parses the coordinates from a GEOS is_valid_reason string such as:
        'Ring Self-intersection at or near point -34.96 -6.60'
    Returns (x, y) or None if parsing fails.
    """
    try:
        # Typical format: "... at or near point X Y" or "... at X Y"
        for marker in ("at or near point ", "at point ", "near point "):
            if marker in reason:
                coords_str = reason.split(marker, 1)[1].strip()
                parts = coords_str.split()
                if len(parts) >= 2:
                    return (float(parts[0]), float(parts[1]))
    except (ValueError, IndexError):
        pass
    return None


def _ring_coords(geom) -> list[tuple[float, float]]:
    """Returns the exterior ring coordinate list of a Polygon/MultiPolygon."""
    import shapely
    geom_type = geom.geom_type
    if geom_type == "MultiPolygon":
        # Use the largest sub-polygon for classification
        largest = max(geom.geoms, key=lambda g: g.area)
        return list(largest.exterior.coords)
    elif geom_type == "Polygon":
        return list(geom.exterior.coords)
    return []


def _has_duplicate_consecutive_coords(coords: list[tuple]) -> bool:
    """Returns True if any two consecutive vertices are identical."""
    for i in range(len(coords) - 1):
        if coords[i] == coords[i + 1]:
            return True
    return False


def _has_near_duplicate_consecutive_coords(
    coords: list[tuple], tol: float = 1e-10
) -> bool:
    """Returns True if any two consecutive vertices are within `tol` of each other."""
    for i in range(len(coords) - 1):
        dx = coords[i][0] - coords[i + 1][0]
        dy = coords[i][1] - coords[i + 1][1]
        if (dx * dx + dy * dy) ** 0.5 < tol:
            return True
    return False


def _spike_angle_check(coords: list[tuple], angle_thresh_deg: float = 0.5) -> bool:
    """
    Returns True if any interior angle is close to 180° (spike/needle vertex).
    A spike occurs when a segment goes out and comes back nearly the same path.
    """
    import math
    n = len(coords) - 1  # last coord == first coord (closed ring)
    if n < 3:
        return False
    for i in range(n):
        p0 = coords[(i - 1) % n]
        p1 = coords[i]
        p2 = coords[(i + 1) % n]
        # Vectors p1→p0 and p1→p2
        v1 = (p0[0] - p1[0], p0[1] - p1[1])
        v2 = (p2[0] - p1[0], p2[1] - p1[1])
        len1 = (v1[0] ** 2 + v1[1] ** 2) ** 0.5
        len2 = (v2[0] ** 2 + v2[1] ** 2) ** 0.5
        if len1 < 1e-15 or len2 < 1e-15:
            continue
        cos_a = (v1[0] * v2[0] + v1[1] * v2[1]) / (len1 * len2)
        cos_a = max(-1.0, min(1.0, cos_a))
        angle_deg = math.degrees(math.acos(cos_a))
        if angle_deg > (180.0 - angle_thresh_deg):
            return True
    return False


# ---------------------------------------------------------------------------
# Classifier
# ---------------------------------------------------------------------------

class RingSelfIntersectionClassifier:
    """
    Classifies Ring Self-Intersection geometry errors by semantic subtype.

    Usage (single geometry)::

        clf = RingSelfIntersectionClassifier()
        result = clf.classify(geom, reason="Ring Self-intersection at or near point ...")
        print(result.si_type, result.is_error)

    Usage (batch)::

        results = clf.classify_batch(geom_list, reasons)

    All Shapely operations use the functional API (Shapely 2.x) where
    available, falling back gracefully to the object-based API (Shapely 1.x).
    """

    # Area tolerance: if the fixed geometry area differs from the original by
    # less than this fraction, it is considered a precision artefact.
    AREA_RATIO_THRESHOLD: float = 0.999

    # Coordinate tolerance for near-duplicate vertex detection (degrees for
    # geographic CRS, metres for projected CRS).
    COORD_TOLERANCE: float = 1e-8

    # Spike detection: interior angle threshold in degrees
    SPIKE_ANGLE_THRESH: float = 0.5

    def __init__(self) -> None:
        import shapely as _shp
        self._HAS_MAKE_VALID    = hasattr(_shp, "make_valid")
        self._HAS_IS_VALID      = hasattr(_shp, "is_valid")
        self._HAS_EQUALS_EXACT  = hasattr(_shp, "equals_exact")
        self._HAS_AREA          = hasattr(_shp, "area")

    # ------------------------------------------------------------------
    # Public API
    # ------------------------------------------------------------------

    def classify(
        self,
        geom,
        reason: str = "",
    ) -> RingSIResult:
        """
        Classifies a single geometry with a known Ring Self-Intersection.

        Parameters
        ----------
        geom:
            Shapely geometry object (Polygon or MultiPolygon).
        reason:
            String returned by ``shapely.is_valid_reason(geom)``.

        Returns
        -------
        RingSIResult
        """
        touch_point = _extract_touch_point(reason)

        try:
            return self._classify_impl(geom, touch_point)
        except Exception as exc:
            return RingSIResult(
                si_type=RingSIType.UNKNOWN,
                is_error=False,
                description=f"Classification error: {exc}",
                touch_point=touch_point,
            )

    def classify_batch(
        self,
        geoms: list,
        reasons: list[str],
    ) -> list[RingSIResult]:
        """
        Classifies a list of geometries in batch.

        This method first runs a vectorised pre-screening pass using
        ``shapely.make_valid`` on all geometries at once, then dispatches
        each suspect to the per-geometry classifier.

        Parameters
        ----------
        geoms:
            List of Shapely geometry objects.
        reasons:
            Parallel list of ``is_valid_reason`` strings.

        Returns
        -------
        List of RingSIResult, one per input geometry.
        """
        if not geoms:
            return []

        import shapely
        import numpy as np

        geom_arr = np.asarray(geoms, dtype=object)

        # Vectorised make_valid for all candidates at once
        if self._HAS_MAKE_VALID:
            fixed_arr = shapely.make_valid(geom_arr)
        else:
            fixed_arr = geom_arr  # fallback: no batch fix

        # Vectorised area comparison
        if self._HAS_AREA:
            orig_areas = shapely.area(geom_arr)
            fixed_areas = shapely.area(fixed_arr)
        else:
            orig_areas = np.array([g.area for g in geom_arr])
            fixed_areas = np.array([g.area for g in fixed_arr])

        results: list[RingSIResult] = []
        for i, (geom, fixed, orig_area, fixed_area, reason) in enumerate(
            zip(geom_arr, fixed_arr, orig_areas, fixed_areas, reasons)
        ):
            touch_point = _extract_touch_point(reason)
            try:
                result = self._classify_with_precomputed(
                    geom, fixed, orig_area, fixed_area, touch_point
                )
            except Exception as exc:
                result = RingSIResult(
                    si_type=RingSIType.UNKNOWN,
                    is_error=False,
                    description=f"Classification error: {exc}",
                    touch_point=touch_point,
                )
            results.append(result)

        return results

    # ------------------------------------------------------------------
    # Internal classification logic
    # ------------------------------------------------------------------

    def _classify_impl(self, geom, touch_point) -> RingSIResult:
        """Per-geometry classification without pre-computed values."""
        import shapely

        if self._HAS_MAKE_VALID:
            fixed = shapely.make_valid(geom)
        else:
            fixed = geom

        orig_area  = geom.area  if hasattr(geom, "area")  else 0.0
        fixed_area = fixed.area if hasattr(fixed, "area") else 0.0

        return self._classify_with_precomputed(
            geom, fixed, orig_area, fixed_area, touch_point
        )

    def _classify_with_precomputed(
        self,
        geom,
        fixed,
        orig_area: float,
        fixed_area: float,
        touch_point,
    ) -> RingSIResult:
        """
        Core classification decision tree using pre-computed make_valid result
        and areas (enables reuse from classify_batch without re-computing).
        """
        import shapely

        coords = _ring_coords(geom)
        fixed_type = fixed.geom_type if fixed is not None else "unknown"

        area_ratio = (fixed_area / orig_area) if orig_area > 1e-20 else None

        # ── Step 1: Duplicate consecutive coordinate → Kiss / Duplicate edge ──
        if _has_duplicate_consecutive_coords(coords):
            return RingSIResult(
                si_type=RingSIType.KISS,
                is_error=False,
                description=(
                    "Ring visits the same vertex consecutively (Kiss / touch point). "
                    "No ambiguous interior — tolerance artefact."
                ),
                touch_point=touch_point,
                area_ratio=area_ratio,
            )

        # ── Step 2: Near-duplicate coordinate → Kiss or precision artefact ──
        if _has_near_duplicate_consecutive_coords(coords, tol=self.COORD_TOLERANCE):
            return RingSIResult(
                si_type=RingSIType.KISS,
                is_error=False,
                description=(
                    "Near-duplicate consecutive vertex detected. "
                    "Likely floating-point precision artefact (Kiss)."
                ),
                touch_point=touch_point,
                area_ratio=area_ratio,
            )

        # ── Step 3: make_valid produces MultiPolygon ──────────────────────────
        if "Multi" in fixed_type:
            n_parts = len(fixed.geoms) if hasattr(fixed, "geoms") else 1

            if area_ratio is not None and area_ratio < self.AREA_RATIO_THRESHOLD:
                # Significant area loss → the ring truly divided the polygon
                # in two separate pieces sharing a crossing boundary.
                si_type = (
                    RingSIType.BOW_TIE
                    if n_parts == 2
                    else RingSIType.FIGURE_EIGHT
                )
                return RingSIResult(
                    si_type=si_type,
                    is_error=True,
                    description=(
                        f"Ring crosses itself creating {n_parts} separate area(s). "
                        f"Area ratio original→fixed: {area_ratio:.4f}. "
                        "Ambiguous interior — genuine topological error."
                    ),
                    touch_point=touch_point,
                    area_ratio=area_ratio,
                )
            else:
                # Area preserved after make_valid despite becoming MultiPolygon:
                # the ring touches itself at a point without crossing.
                return RingSIResult(
                    si_type=RingSIType.PINCH,
                    is_error=False,
                    description=(
                        "Ring self-touches at a single point (Pinch). "
                        "Area preserved — no ambiguous interior."
                    ),
                    touch_point=touch_point,
                    area_ratio=area_ratio,
                )

        # ── Step 4: make_valid changes area but stays Polygon ─────────────────
        if area_ratio is not None and area_ratio < self.AREA_RATIO_THRESHOLD:
            return RingSIResult(
                si_type=RingSIType.CROSSING,
                is_error=True,
                description=(
                    f"Ring crosses itself with significant area change "
                    f"(ratio: {area_ratio:.4f}). "
                    "Ambiguous interior — genuine topological error."
                ),
                touch_point=touch_point,
                area_ratio=area_ratio,
            )

        # ── Step 5: Spike detection ───────────────────────────────────────────
        if _spike_angle_check(coords, self.SPIKE_ANGLE_THRESH):
            return RingSIResult(
                si_type=RingSIType.SPIKE,
                is_error=False,
                description=(
                    "Spike vertex detected (interior angle ≈ 180°). "
                    "Geometry goes out and returns — generally not a real error."
                ),
                touch_point=touch_point,
                area_ratio=area_ratio,
            )

        # ── Step 6: Tangential touch / Zero-area loop ─────────────────────────
        # At this point make_valid did not change the type or significantly
        # alter the area. Check if the fixed geometry equals the original
        # within tolerance (pure floating-point artefact).
        if self._HAS_EQUALS_EXACT:
            unchanged = shapely.equals_exact(geom, fixed, tolerance=self.COORD_TOLERANCE)
        else:
            unchanged = (geom.wkt == fixed.wkt)

        if unchanged:
            return RingSIResult(
                si_type=RingSIType.TANGENTIAL_TOUCH,
                is_error=False,
                description=(
                    "Ring segments are tangentially touching or collinear. "
                    "make_valid produced no structural change — "
                    "floating-point precision artefact (Tangential Touch)."
                ),
                touch_point=touch_point,
                area_ratio=area_ratio,
            )

        # ── Step 7: Zero-area loop ────────────────────────────────────────────
        if area_ratio is not None and abs(orig_area - fixed_area) < 1e-14:
            return RingSIResult(
                si_type=RingSIType.ZERO_AREA_LOOP,
                is_error=False,
                description=(
                    "Zero-area loop detected. "
                    "Ring contains a degenerate sub-loop with zero enclosed area."
                ),
                touch_point=touch_point,
                area_ratio=area_ratio,
            )

        # ── Step 8: Duplicate edge ────────────────────────────────────────────
        # Two segments traverse the same path in opposite directions.
        # make_valid changes geometry but no area difference.
        return RingSIResult(
            si_type=RingSIType.DUPLICATE_EDGE,
            is_error=False,
            description=(
                "Possible duplicate edge — two segments share the same path. "
                "Context-dependent: review geometry manually."
            ),
            touch_point=touch_point,
            area_ratio=area_ratio,
        )
